---
const { frontmatter, headings } = Astro.props;
import Layout from "../Layout.astro";
import Footer from "../../components/web/footer.astro";
import "../../assets/web/fonts.css";
import "../../assets/web/teleport.css";
const baseURL = import.meta.env.BASE_URL;
---

<Layout {frontmatter}>
  <header class="hero">
    <img src={`${baseURL}/web/img/minisplash-logo.png`} alt="PolarisOS" />
    <img
      src={`${baseURL}/web/img/minisplash-right.png`}
      alt=""
      aria-hidden="true"
    />
  </header>

  <nav>
    <ul>
      On this page:
      {headings
        .filter((heading) => heading.depth > 1 && heading.depth < 4)
        .map((heading) => (
          <li class={`depth-${heading.depth}`}>
            <a href={"#" + heading.slug}>
              <img src={`${baseURL}/web/img/bullet.png`} alt="" />
              {heading.text}
            </a>
          </li>
        ))}
    </ul>
  </nav>

  <article class="md">
    <slot />
    <Footer />
  </article>
</Layout>

<style>
  :root {
    --header-height: 64px;
  }

  html,
  body {
    margin: 0;
    padding: 0;
  }

  body {
    display: grid;

    grid-template-areas:
      "header header"
      "nav article"
      "footer footer";
  }

  header {
    display: flex;
    grid-area: header;
    justify-content: space-between;
    background-color: black;
    height: var(--header-height);
  }

  nav {
    top: var(--header-height);
    grid-area: nav;
    padding: 16px;
    height: calc(100vh - var(--header-height) - 32px);

    ul {
      margin: 0;
      padding: 0;
      list-style: none;

      li {
        &.depth-3 {
          padding-inline-start: 8px;
        }

        img {
          margin-inline-end: 8px;
        }
      }
    }
  }

  article {
    grid-area: article;
    padding: 16px;
    overflow: auto;
    scroll-padding-block: 16px;

    h1 {
      margin-top: 0;
    }
  }
</style>

<style is:global>
  .md {
    p.opening {
      font-size: 1.25em;
    }
  }
</style>
